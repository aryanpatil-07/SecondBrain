# Second Brain — Environment Variables Template
# @concept Environment variables & secrets management

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/secondbrain?retryWrites=true&w=majority

# OpenRouter AI Gateway API Key
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Default Model & Application Metadata
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=SecondBrain

# Server Execution Port
PORT=3000
